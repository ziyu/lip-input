# Not automatically loaded. Export these variables in the server's environment.
# Keep disabled until you have reviewed upstream code, installed its dependencies,
# acquired trusted weights, and verified rights for your exact use.
LIP_ENABLE_UPSTREAM=0
LIP_LICENSE_ACK=
LIP_UPSTREAM_ROOT=/opt/lip-model/Visual_Speech_Recognition_for_Multiple_Languages
LIP_RUNTIME_PYTHON=/opt/lip-model/venv/bin/python
LIP_CONFIG_EN=/opt/lip-model/Visual_Speech_Recognition_for_Multiple_Languages/configs/LRS3_V_WER19.1.ini
LIP_CONFIG_ZH=/opt/lip-model/Visual_Speech_Recognition_for_Multiple_Languages/configs/CMLR_V_WER8.0.ini
LIP_DEVICE=cpu
# Optional private, operator-owned temporary directory (prefer encrypted tmpfs).
# LIP_TEMP_DIR=/run/user/1000/lip-input
